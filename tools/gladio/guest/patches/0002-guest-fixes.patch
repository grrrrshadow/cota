+
+// Reads image data the host sent through the ring. With a pixel pack buffer bound, pixels is
+// an offset into it, so the data goes to the buffer memory shared with the host.
+static void readPixelPackData(void* pixels, int imageSize) {
+    GLBuffer* pixelPackBuffer = GLBuffer_getBound(GL_PIXEL_PACK_BUFFER);
+    if (pixelPackBuffer) {
+        if (pixelPackBuffer->mappedData && (uint64_t)pixels + imageSize <= pixelPackBuffer->size) {
+            pixels = pixelPackBuffer->mappedData + (uint64_t)pixels;
+        }
+        else pixels = NULL;
+    }
+
+    if (pixels) {
+        RingBuffer_read(currentGLContext->clientRing, pixels, imageSize);
+    }
+    else discardRingData(imageSize);
+}
