+// The host sends the rows tightly packed, they are placed with the pack state set by glPixelStorei
+static void readPackedPixels(GLenum format, GLenum type, GLsizei width, GLsizei height, void* pixels, int imageSize) {
+    GLClientState* clientState = currentGLContext->clientState;
+    RingBuffer* ring = currentGLContext->clientRing;
+    int rowSize = computeTexImageDataSize(format, type, width, 1, 1);
+    if (rowSize * height != imageSize) {
+        discardRingData(imageSize);
+        return;
+    }
+
+    int rowStride = computePixelRowStride(format, type, width, clientState->pixelStore.packRowLength, clientState->pixelStore.packAlignment);
+    char* dstData = (char*)pixels + clientState->pixelStore.packSkipRows * rowStride + clientState->pixelStore.packSkipPixels * (rowSize / width);
+    if (rowStride == rowSize) {
+        RingBuffer_read(ring, dstData, imageSize);
+    }
+    else for (int i = 0; i < height; i++) RingBuffer_read(ring, dstData + i * rowStride, rowSize);
+}
