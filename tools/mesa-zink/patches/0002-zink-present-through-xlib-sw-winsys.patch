+#include "frontend/sw_winsys.h"
+
+static void
+zink_flush_frontbuffer_sw(struct zink_screen *screen, struct pipe_context *pctx,
+                          struct zink_resource *res, unsigned level, unsigned layer,
+                          void *drawable, unsigned nboxes, struct pipe_box *sub_box)
+{
+   struct sw_winsys *winsys = screen->winsys;
+   struct pipe_resource *pres = &res->base.b;
+
+   if (pctx) {
+      void *map = winsys->displaytarget_map(winsys, res->sw_dt, PIPE_MAP_WRITE);
+      if (map) {
+         struct pipe_transfer *transfer = NULL;
+         void *res_map = pipe_texture_map(pctx, pres, level, layer, PIPE_MAP_READ, 0, 0,
+                                          u_minify(pres->width0, level),
+                                          u_minify(pres->height0, level), &transfer);
+         if (res_map) {
+            util_copy_rect(map, pres->format, res->dt_stride, 0, 0,
+                           transfer->box.width, transfer->box.height,
+                           res_map, transfer->stride, 0, 0);
+            pipe_texture_unmap(pctx, transfer);
+         }
+         winsys->displaytarget_unmap(winsys, res->sw_dt);
+      }
+   }
+   winsys->displaytarget_display(winsys, res->sw_dt, drawable, nboxes, sub_box);
+}
+
 static void
 zink_flush_frontbuffer(struct pipe_screen *pscreen,
                        struct pipe_context *pctx,
